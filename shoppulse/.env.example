# SHOPPULSE 3.0 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 Git에 올라가지 않습니다.

# 서버 포트 (start.bat 가 브라우저를 여는 주소와 일치해야 함)
SHOPPULSE_PORT=8787

# 데이터 저장 폴더 (비우면 shoppulse/data 사용)
SHOPPULSE_DATA_DIR=

# YouTube Data API v3 키 (없으면 자동 수집 기능이 '미설정' 으로 표시됨)
YOUTUBE_API_KEY=

# AI 쇼츠 기획 어댑터 (anthropic 또는 template). 키가 없으면 template 로 동작
SHOPPULSE_AI_PROVIDER=template
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# 기본 지역 (날씨·계절 참고용)
SHOPPULSE_DEFAULT_REGION=서울

# 자동 소싱(매일 05:00 Asia/Seoul) 활성화 여부. 안정성 검증 후 true 로 변경
SHOPPULSE_AUTO_SOURCING=false
