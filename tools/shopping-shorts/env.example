# 이 파일을 .env 로 복사해 값을 채운다. .env 는 깃에 올라가지 않는다.

# 전체 자동 실행(분석·컷 설계·화면 검수)에 쓰는 Claude API 키
ANTHROPIC_API_KEY=

# TTS(일레븐랩스). 목소리는 계정의 'kanna - Calm & Friendly' 를 이름으로 찾는다.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_VOICE_NAME=kanna

# 댓글 가져오기(선택). 없으면 yt-dlp 를 쓴다.
# YOUTUBE_API_KEY=

# 모델 바꾸기(선택)
# SHORTS_MODEL=claude-opus-5-5
# SHORTS_EFFORT=high

# 실제 유튜브 댓글 캡처를 끄려면 0 (끄면 프로그램이 그린 댓글 상자를 쓴다)
# SHORTS_CAPTURE=1
